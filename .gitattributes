# Normalise line endings in the repository; Windows checkouts get CRLF.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.md      text
*.ps1     text eol=crlf

*.ico     binary
*.png     binary

# Keep the website and the maintainer's publishing tools out of the "Source code" archives on GitHub releases.
site/                    export-ignore
docs/                    export-ignore
scripts/package-site.ps1 export-ignore
.gitattributes           export-ignore
