<Window x:Class="VlcRedesign.Views.SubtitleSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VlcRedesign.Controls"
        xmlns:svc="clr-namespace:VlcRedesign.Services"
        Title="Find subtitles" Width="680" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        WindowStyle="None" Background="{StaticResource PopupBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ctl:BoolToVisibility x:Key="Vis"/>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type svc:SubtitleResult}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#2E2E2E" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{Binding Language}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Release" Text="{Binding Release}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Release}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding FileName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Downloads, Mode=OneWay, StringFormat={}{0:N0} downloads}"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Background="#3A2A10" CornerRadius="4" Padding="6,2" Margin="10,2,0,0" VerticalAlignment="Top"
                        Visibility="{Binding HashMatch, Converter={StaticResource Vis}}" ToolTip="Made for this exact file">
                    <TextBlock Text="Exact match" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="ResultContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Release}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33261A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource PopupBorderBrush}" BorderThickness="1">
        <DockPanel Margin="20,0,20,16">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Height="48">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ctl:Icon Data="{StaticResource I.Subtitles}" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" StrokeThickness="1.8"/>
                    <TextBlock Text="Find subtitles" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"/>
                    <TextBlock Text="OpenSubtitles.com" Foreground="{StaticResource MutedBrush}" Margin="10,1,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Close" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ctl:Icon Data="{StaticResource I.X}" StrokeThickness="1.6"/>
                </Button>
            </Grid>

            <!-- Account settings -->
            <Border x:Name="AccountPanel" DockPanel.Dock="Top" Background="#1C1C1C" CornerRadius="8" Padding="14" Margin="0,4,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}">
                        Subtitles come from OpenSubtitles.com, which needs your own free API key.
                        <Hyperlink NavigateUri="https://www.opensubtitles.com/consumers" RequestNavigate="OnLink" Foreground="{StaticResource AccentBrush}">Get one here</Hyperlink>.
                        Logging in with your OpenSubtitles account is optional but raises the daily download limit.
                    </TextBlock>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="API key" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/>
                        <TextBox x:Name="ApiKeyBox" Grid.Column="1" Style="{StaticResource FieldBox}" Tag="Paste your API key" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Username" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/>
                        <TextBox x:Name="UserBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Tag="Optional" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}"/>
                        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PasswordField}" Margin="0,0,0,6"
                                     ToolTip="Stored encrypted for your Windows account"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="AutoBox" Style="{StaticResource DarkCheck}" Content="Download automatically when a video has no subtitles"/>
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource DialogButton}" Content="Save" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="#141414" FontWeight="SemiBold" Click="OnSaveAccount"/>
                </StackPanel>
            </Border>

            <!-- Search -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" Style="{StaticResource FieldBox}" Tag="Title, e.g. The Wand S01E05" KeyDown="OnQueryKey"
                         AutomationProperties.Name="Title"/>
                <TextBox x:Name="LanguagesBox" Grid.Column="1" Style="{StaticResource FieldBox}" Tag="en,ro" Margin="8,0,0,0"
                         ToolTip="Language codes, comma separated (en, ro, fr, pt-br…)" AutomationProperties.Name="Languages"/>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="HashButton" Style="{StaticResource DialogButton}" Content="Search by hash" Click="OnSearchHash"
                        ToolTip="Finds subtitles made for this exact file"/>
                <Button x:Name="NameButton" Style="{StaticResource DialogButton}" Content="Search by name" Margin="8,0,0,0" Click="OnSearchName"/>
            </StackPanel>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Style="{StaticResource DialogButton}" Content="Account…" HorizontalAlignment="Left" Click="OnToggleAccount"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}" Content="Close" Click="OnClose" IsCancel="True"/>
                    <Button x:Name="DownloadButton" Style="{StaticResource DialogButton}" Content="Download and use" Margin="8,0,0,0" IsEnabled="False"
                            Background="{StaticResource AccentBrush}" Foreground="#141414" FontWeight="SemiBold" Click="OnDownload"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,10,0,0"/>

            <!-- Results -->
            <Border Background="#1A1A1A" CornerRadius="8" Padding="4">
                <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ResultTemplate}"
                         ItemContainerStyle="{StaticResource ResultContainer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnResultDoubleClick" AutomationProperties.Name="Results"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
