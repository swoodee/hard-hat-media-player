<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The app mark: a hard hat seen from the side, facing right, in the interface orange.
        Drawn on a 24x24 grid. This file is the single source for both the title bar and
        Assets/app.ico (scripts/make-icon.ps1 renders it), so keep colours as literals here.
    -->
    <DrawingImage x:Key="AppMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fixed 24x24 frame so every use scales the same way -->
                <GeometryDrawing Brush="Transparent" Geometry="M0 0 H24 V24 H0 Z"/>
                <!-- Shell: crown set towards the back, longer slope to the front -->
                <GeometryDrawing Brush="#FF8800" Geometry="M3.3 15 C3.1 9.5 6.5 5.8 10.9 5.8 C15.7 5.8 19.2 9.1 19.8 13.4 L20 15 Z"/>
                <!-- Raised ridge running front to back over the crown -->
                <GeometryDrawing Brush="#FFB35C" Geometry="M5 11.4 C5.9 8.2 8.2 6.5 10.9 6.5 C14.3 6.5 17.1 8.5 18.3 11.2 L16.8 11.8 C15.8 9.6 13.6 8.1 10.9 8.1 C8.9 8.1 7.2 9.4 6.5 11.8 Z"/>
                <!-- Rain gutter band above the brim -->
                <GeometryDrawing Brush="#E06F00" Geometry="M3.4 12.9 H19.6 L19.8 14.7 H3.3 Z"/>
                <!-- Brim: short at the back, long peak at the front -->
                <GeometryDrawing Brush="#B85A00" Geometry="M2.4 14.6 H18.8 C21 14.6 22.6 15.5 23.5 16.7 C23.8 17.1 23.5 17.7 22.9 17.7 H2.4 C1.7 17.7 1.2 17.1 1.2 16.15 C1.2 15.2 1.7 14.6 2.4 14.6 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
