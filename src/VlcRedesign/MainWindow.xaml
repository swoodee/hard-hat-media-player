<Window x:Class="VlcRedesign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:ctl="clr-namespace:VlcRedesign.Controls"
        xmlns:vm="clr-namespace:VlcRedesign.ViewModels"
        Title="VLC Media Player" Icon="Assets/app.ico" Width="1280" Height="780" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource ChromeBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ctl:BoolToVisibility x:Key="Vis"/>
        <ctl:PathToImage x:Key="Img"/>

        <!-- VLC cone -->
        <DrawingImage x:Key="Cone">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E06F00" Geometry="M3.5 19 H20.5 A1 1 0 0 1 21.5 20 V21 A1 1 0 0 1 20.5 22 H3.5 A1 1 0 0 1 2.5 21 V20 A1 1 0 0 1 3.5 19 Z"/>
                    <GeometryDrawing Brush="{StaticResource AccentBrush}" Geometry="M9.5 2 H14.5 L19 19 H5 Z"/>
                    <GeometryDrawing Brush="White" Geometry="M8.18 7 H15.82 L16.72 10.4 H7.28 Z M6.48 13.4 H17.52 L18.31 16.4 H5.69 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Library list rows -->
        <DataTemplate DataType="{x:Type vm:ItemRow}">
            <Grid Height="32" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ctl:Icon x:Name="Ico" Data="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" StrokeThickness="1.8"/>
                <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="4" HorizontalAlignment="Left" Visibility="Collapsed" Background="#222">
                    <Border.Child>
                        <Border CornerRadius="4">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail, Converter={StaticResource Img}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border.Child>
                </Border>
                <TextBlock x:Name="Lbl" Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,0,2,0" VerticalAlignment="Center"
                           Visibility="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAction}" Value="True">
                    <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Text2Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SectionRow}">
            <Grid Height="34" Margin="0,10,0,0" Background="Transparent">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <ctl:Icon Data="{StaticResource I.ChevronRight}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"
                          Visibility="{Binding HasOpen, Converter={StaticResource Vis}}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowPress"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClick"/>
            <EventSetter Event="MouseRightButtonUp" Handler="OnRowRightClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D1D1D"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#222"/>
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding IsSection}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Focusable" Value="False"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="16" Padding="14,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid x:Name="TitleBar" Background="{StaticResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="{StaticResource Cone}" Width="18" Height="18" Margin="0,0,8,0"/>
                <Button Style="{StaticResource IconButton}" ToolTip="Menu" Click="OnMainMenu" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ctl:Icon Data="{StaticResource I.More}" StrokeThickness="3"/>
                </Button>
                <ToggleButton Style="{StaticResource IconButton}" ToolTip="Library panel (Ctrl+B)" IsChecked="{Binding IsPanelOpen}"
                              WindowChrome.IsHitTestVisibleInChrome="True" Margin="2,0,0,0">
                    <ctl:Icon Data="{StaticResource I.Sidebar}" StrokeThickness="1.8"/>
                </ToggleButton>
                <Border Width="1" Height="16" Background="#333" Margin="8,0"/>
                <Button Style="{StaticResource IconButton}" Width="Auto" Padding="6,4" Command="{Binding OpenSourceCommand}"
                        ToolTip="Show where this is playing from" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <ctl:Icon Data="{StaticResource I.Folder}" StrokeThickness="1.8"/>
                        <TextBlock x:Name="SourceText" Text="{Binding Player.SourceLabel, TargetNullValue=Library}" Margin="7,0,2,0" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="WindowTitle" Grid.Column="2" Text="VLC Media Player" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                       VerticalAlignment="Center" Margin="12,0,16,0" MaxWidth="420" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize">
                    <ctl:Icon Data="{StaticResource I.Minimize}" Width="14" Height="14" StrokeThickness="1.5"/>
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize">
                    <ctl:Icon x:Name="MaxIcon" Data="{StaticResource I.Maximize}" Width="12" Height="12" StrokeThickness="1.8"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="OnClose" ToolTip="Close">
                    <ctl:Icon Data="{StaticResource I.X}" Width="14" Height="14" StrokeThickness="1.5"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailCol" Width="48"/>
                <ColumnDefinition x:Name="PanelCol" Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon rail -->
            <StackPanel x:Name="RailPanel" Background="{StaticResource ChromeBrush}" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding Rail}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RailItem}">
                            <Button Style="{StaticResource RailButton}" ToolTip="{Binding Label}"
                                         Command="{Binding DataContext.SelectRailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <ctl:Icon Data="{Binding Icon}" StrokeThickness="1.8"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Padding="8" Margin="0,2" Command="{Binding OpenFilesCommand}" ToolTip="Open media (Ctrl+O)">
                    <ctl:Icon Data="{StaticResource I.Plus}" StrokeThickness="1.8"/>
                </Button>
            </StackPanel>

            <!-- Library panel -->
            <Grid x:Name="LibraryPanel" Grid.Column="1" Background="{StaticResource PanelBrush}" DataContext="{Binding Panel}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="44" Margin="8,4,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back (Alt+Left)">
                            <ctl:Icon Data="{StaticResource I.ArrowLeft}" StrokeThickness="1.8"/>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward (Alt+Right)">
                            <ctl:Icon Data="{StaticResource I.ArrowRight}" StrokeThickness="1.8"/>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding Page.Title}" FontSize="14.5" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnPageMenu" ToolTip="More"
                                Visibility="{Binding Page.Menu, Converter={StaticResource Vis}}">
                            <ctl:Icon Data="{StaticResource I.More}" StrokeThickness="3"/>
                        </Button>
                        <ToggleButton Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="Expand panel"
                                      IsChecked="{Binding DataContext.IsPanelWide, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ctl:Icon Data="{StaticResource I.PopOut}" StrokeThickness="1.8"/>
                        </ToggleButton>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Height="30" Margin="16,0,8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding CycleSortCommand}" ToolTip="{Binding SortLabel}"
                                IsEnabled="{Binding Page.CanSort}">
                            <ctl:Icon Data="{StaticResource I.Sort}" StrokeThickness="1.8"/>
                        </Button>
                        <ToggleButton Grid.Column="2" Style="{StaticResource IconButton}" IsChecked="{Binding ShowDetails}" ToolTip="Show details">
                            <ctl:Icon Data="{StaticResource I.Details}" StrokeThickness="1.8"/>
                        </ToggleButton>
                        <ToggleButton Grid.Column="3" Style="{StaticResource IconButton}" IsChecked="{Binding IsSearchOpen}" ToolTip="Search (Ctrl+F)" Click="OnSearchToggled">
                            <ctl:Icon Data="{StaticResource I.Search}" StrokeThickness="1.8"/>
                        </ToggleButton>
                    </Grid>

                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource FieldBox}" Tag="Search this page" Margin="14,2,12,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsSearchOpen, Converter={StaticResource Vis}}"/>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" Margin="14,2,12,4"/>

                    <Grid>
                        <ctl:RowList x:Name="PanelList" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource RowContainer}"
                                 Background="Transparent" BorderThickness="0" Padding="6,0,6,8" Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" KeyDown="OnListKeyDown"/>
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="24,28,24,0" VerticalAlignment="Top" IsHitTestVisible="False"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                    </Grid>
                </DockPanel>
            </Grid>
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeBehavior="CurrentAndNext"
                          ResizeDirection="Columns" DragCompleted="OnSplitterDragged" Focusable="False" Cursor="SizeWE"/>

            <!-- Player -->
            <vlc:VideoView x:Name="Video" Grid.Column="2" Background="Black">
                <Grid x:Name="Overlay" Background="#01000000" AllowDrop="True" Drop="OnDrop"
                      TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13"
                      MouseMove="OnOverlayMouseMove" MouseLeftButtonDown="OnOverlayClick" MouseWheel="OnOverlayWheel">

                    <!-- Idle state and audio "now playing" -->
                    <Grid Background="{StaticResource ContentBrush}" Visibility="{Binding Player.ShowBackdrop, Converter={StaticResource Vis}}">
                        <Grid Visibility="{Binding Player.HasMedia, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="0.7*"/>
                            </Grid.RowDefinitions>
                            <ctl:PixelCat Width="200" Height="176" VerticalAlignment="Bottom"/>
                            <Border Grid.Row="1" Background="#262626"/>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,36,0,0">
                                <TextBlock Text="Drop a file or folder here to start watching" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Style="{StaticResource PillButton}" Command="{Binding OpenFilesCommand}" Content="Open file"/>
                                    <Button Style="{StaticResource PillButton}" Command="{Binding OpenFolderCommand}" Content="Open folder"/>
                                    <Button Style="{StaticResource PillButton}" Command="{Binding OpenNetworkStreamCommand}" Content="Network stream"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="NowPlayingCard" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,110"
                                    Visibility="{Binding Player.ShowNowPlayingCard, Converter={StaticResource Vis}}">
                            <Grid Width="200" Height="200">
                                <Border CornerRadius="14" Background="#222">
                                    <Grid>
                                        <ctl:Icon Data="{StaticResource I.Note}" Width="64" Height="64" Foreground="#4A4A4A" StrokeThickness="1.2"
                                                  Visibility="{Binding Player.IsVideoCard, Converter={StaticResource Vis}, ConverterParameter=Invert}"/>
                                        <ctl:Icon Data="{StaticResource I.Film}" Width="64" Height="64" Foreground="#4A4A4A" StrokeThickness="1.2"
                                                  Visibility="{Binding Player.IsVideoCard, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Player.Artwork, Converter={StaticResource Img}, ConverterParameter=440}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Player.Title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="24,22,24,0"
                                       MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Player.Subtitle}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="24,4,24,0"
                                       MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                            <Button Style="{StaticResource PillButton}" Content="Play again" HorizontalAlignment="Center" Margin="0,18,0,0"
                                    Command="{Binding Player.TogglePlayCommand}" Visibility="{Binding Player.IsEnded, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Error toast -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,18,16,0" CornerRadius="8" Background="#F02A1A1A"
                            BorderBrush="#5A2A2A" BorderThickness="1" Padding="14,8" IsHitTestVisible="False"
                            Visibility="{Binding Player.Error, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Player.Error}" Foreground="#FFB4A8" TextWrapping="Wrap" MaxWidth="520"/>
                    </Border>

                    <!-- Controls -->
                    <Border x:Name="ControlsBar" SizeChanged="OnControlsSizeChanged" VerticalAlignment="Bottom" Margin="16,0,16,16" MaxWidth="980" CornerRadius="12"
                            Background="#EB181818" BorderBrush="#2C2C2C" BorderThickness="1" Padding="16,6,16,10"
                            Visibility="{Binding Player.HasMedia, Converter={StaticResource Vis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Player.TimeText}" FontSize="12" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                <Slider x:Name="SeekBar" Grid.Column="1" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1" Margin="8,0"
                                        Value="{Binding Player.Position, Mode=TwoWay}"
                                        PreviewMouseLeftButtonDown="OnScrubStart" PreviewMouseMove="OnScrubMove" PreviewMouseLeftButtonUp="OnScrubEnd"
                                        LostMouseCapture="OnScrubLost" ValueChanged="OnSeekMoved"/>
                                <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ControlsLeftCol" Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="ControlsTitle" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Player.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Player.Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="ShuffleButton" Style="{StaticResource AccentToggle}" Width="32" Height="32" Padding="8" IsChecked="{Binding Player.Shuffle}" ToolTip="Shuffle">
                                        <ctl:Icon Data="{StaticResource I.Shuffle}" StrokeThickness="1.8"/>
                                    </ToggleButton>
                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" Padding="9" Margin="6,0" Command="{Binding Player.PreviousCommand}" ToolTip="Previous (P)">
                                        <ctl:Icon Data="{StaticResource I.Prev}" Filled="True"/>
                                    </Button>
                                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Command="{Binding Player.TogglePlayCommand}" ToolTip="Play (Space)">
                                        <ctl:Icon x:Name="PlayIcon" Data="{StaticResource I.Play}" Filled="True"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" Padding="9" Margin="6,0" Command="{Binding Player.NextCommand}" ToolTip="Next (N)">
                                        <ctl:Icon Data="{StaticResource I.Next}" Filled="True"/>
                                    </Button>
                                    <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Width="32" Height="32" Padding="8" Command="{Binding Player.CycleRepeatCommand}" ToolTip="Repeat: off">
                                        <Grid>
                                            <ctl:Icon Data="{StaticResource I.Repeat}" StrokeThickness="1.8"/>
                                            <TextBlock x:Name="RepeatOne" Text="1" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Padding="7" Click="OnTracksMenu" ToolTip="Subtitles, audio and speed">
                                        <ctl:Icon Data="{StaticResource I.Subtitles}" StrokeThickness="1.8"/>
                                    </Button>
                                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="32" Height="32" Padding="7" Command="{Binding Player.ToggleMuteCommand}" ToolTip="Mute (M)">
                                        <ctl:Icon x:Name="VolumeIcon" Data="{StaticResource I.Volume}" StrokeThickness="1.8"/>
                                    </Button>
                                    <Slider x:Name="VolumeBar" Style="{StaticResource MediaSlider}" Width="90" Minimum="0" Maximum="125" Margin="2,0,8,0" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Player.Volume, Mode=TwoWay}"
                                            PreviewMouseLeftButtonDown="OnScrubStart" PreviewMouseMove="OnScrubMove" PreviewMouseLeftButtonUp="OnScrubEnd" LostMouseCapture="OnScrubLost"
                                            ToolTip="{Binding Player.Volume}" ToolTipService.Placement="Top"/>
                                    <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Width="32" Height="32" Padding="7" Command="{Binding ToggleFullscreenCommand}" ToolTip="Fullscreen (F)">
                                        <ctl:Icon x:Name="FullscreenIcon" Data="{StaticResource I.Fullscreen}" StrokeThickness="1.8"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </vlc:VideoView>
        </Grid>
    </Grid>
</Window>
