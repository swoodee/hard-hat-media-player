<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The app mark: a hard hat in three-quarter view, in the interface orange, with two ridges
        shown as cut-outs. Drawn on a 24x24 grid. This file is the single source for both the
        title bar and Assets/app.ico (scripts/make-icon.ps1 renders it), so keep colours as literals.
    -->
    <DrawingImage x:Key="AppMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fixed 24x24 frame so every use scales the same way -->
                <GeometryDrawing Brush="Transparent" Geometry="M0 0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#FF8800">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <!-- Shell and brim as one silhouette; the brim sweeps lower towards the front-right -->
                            <CombinedGeometry.Geometry1>
                                <PathGeometry Figures="M2.1 13.6 C2.0 9.5 3.6 5.6 6.2 4.5 C7.4 3.9 8.8 3.5 10.9 3.4 C14.2 3.5 17.2 5.2 18.6 7.1 C19.7 8.6 20.2 10.6 20.2 13.8 C21.1 14.4 22.4 15.6 22.9 16.7 C23.3 17.8 22.6 18.7 21.4 19.2 C19.5 19.9 16.9 20.5 14.5 20.6 C13.2 20.6 12.2 20.5 11.4 20.2 C9.6 19.6 7.9 18.7 6.2 17.9 C4.6 17.2 2.9 16.6 1.6 15.9 C0.9 15.5 0.8 14.8 1.1 14.4 C1.3 14.0 1.7 13.8 2.1 13.6 Z"/>
                            </CombinedGeometry.Geometry1>
                            <!-- Two ridges running over the crown, cut out of the shell -->
                            <CombinedGeometry.Geometry2>
                                <PathGeometry Figures="M8.9 3.7 C11.3 5.6 13.0 9.6 13.6 17.3 L14.8 17.05 C14.3 9.4 12.9 5.3 10.4 3.5 Z M13.9 3.9 C16.0 6.0 17.6 9.6 18.2 15.2 L19.1 14.7 C18.7 9.4 17.3 5.8 15.1 4.1 Z"/>
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
